diff --git a/internal/tgc/dc_pools.go b/internal/tgc/dc_pools.go
new file mode 100644
index 0000000..570a074
--- /dev/null
+++ b/internal/tgc/dc_pools.go
@@ -0,0 +1,210 @@
+package tgc
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/gotd/td/bin"
+	"github.com/gotd/td/telegram"
+	"github.com/gotd/td/telegram/auth"
+	"github.com/gotd/td/tg"
+	"github.com/gotd/td/tgerr"
+	"github.com/tgdrive/teldrive/internal/logging"
+	"go.uber.org/zap"
+)
+
+const (
+	dcPoolOpenTimeout = 30 * time.Second // logging in to a DC (export/import authorization)
+	dcPoolRetryAfter  = 30 * time.Second // after a DC failed to open, use the fallback this long (or the flood wait)
+)
+
+var errDCPoolsClosed = errors.New("dc pools closed")
+
+// DCOpener opens a multi-connection invoker to a DC, logged in with the client's authorization.
+type DCOpener func(ctx context.Context, dc int, size int64) (telegram.CloseInvoker, error)
+
+// DCPools gives a warm streaming client several connections to each DC it reads files from.
+// Without it, gotd sends a read for a file on another DC (FILE_MIGRATE) through one
+// sub-connection, which serves one request at a time (a pool.DC of max 1). A warm bot then
+// fetched one chunk at a time for every stream it served, and a scan's reads queued behind it,
+// holding memory. Each DC is opened once, on first use, with size connections and the client's
+// middlewares (rate limit, flood-wait standby, recovery). If a DC can't be opened, reads use the
+// client's own API (gotd's single sub-connection) and the DC is tried again after a while.
+type DCPools struct {
+	ctx         context.Context
+	size        int64
+	open        DCOpener
+	fallback    *tg.Client
+	middlewares []telegram.Middleware
+	timeout     time.Duration
+	retryAfter  time.Duration
+	now         func() time.Time
+	logger      *zap.Logger
+
+	mu     sync.Mutex
+	dcs    map[int]*dcPool
+	closed bool
+}
+
+type dcPool struct {
+	ready   chan struct{} // closed once api or err is set
+	api     *tg.Client
+	inv     telegram.CloseInvoker
+	err     error
+	retryAt time.Time // after a failed open: when to try the DC again
+}
+
+// NewDCPools returns the DC pools of a running, logged-in client. ctx is the client's run
+// context: the pools' connections live as long as the client.
+func NewDCPools(ctx context.Context, client *telegram.Client, size int, middlewares ...telegram.Middleware) *DCPools {
+	home := client.Config().ThisDC
+	open := func(ctx context.Context, dc int, size int64) (telegram.CloseInvoker, error) {
+		if dc == home {
+			return client.Pool(size)
+		}
+		return client.DC(ctx, dc, size)
+	}
+	return newDCPools(ctx, size, open, client.API(), middlewares...)
+}
+
+func newDCPools(ctx context.Context, size int, open DCOpener, fallback *tg.Client, middlewares ...telegram.Middleware) *DCPools {
+	return &DCPools{
+		ctx: ctx, size: int64(size), open: open, fallback: fallback, middlewares: middlewares,
+		timeout: dcPoolOpenTimeout, retryAfter: dcPoolRetryAfter, now: time.Now,
+		logger: logging.Component("TG"), dcs: map[int]*dcPool{},
+	}
+}
+
+// API returns the client for reading files stored on dc, opening that DC's connections on first
+// use. It only fails when ctx ends first; dc 0 (unknown) gets the fallback.
+func (p *DCPools) API(ctx context.Context, dc int) (*tg.Client, error) {
+	if dc <= 0 || p.size < 1 {
+		return p.fallback, nil
+	}
+	p.mu.Lock()
+	if p.closed {
+		p.mu.Unlock()
+		return p.fallback, nil
+	}
+	e := p.dcs[dc]
+	if e != nil && e.err != nil && !p.now().Before(e.retryAt) {
+		e = nil
+	}
+	if e == nil {
+		e = &dcPool{ready: make(chan struct{})}
+		p.dcs[dc] = e
+		go p.start(dc, e)
+	}
+	p.mu.Unlock()
+
+	select {
+	case <-e.ready:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	if e.api == nil {
+		return p.fallback, nil
+	}
+	return e.api, nil
+}
+
+// start opens dc's connections. It runs on the pools' context, not a request's, so a request that
+// goes away doesn't fail the login for the others waiting on it.
+func (p *DCPools) start(dc int, e *dcPool) {
+	ctx, cancel := context.WithTimeout(p.ctx, p.timeout)
+	defer cancel()
+	inv, err := p.open(ctx, dc, p.size)
+
+	p.mu.Lock()
+	if err == nil && p.closed {
+		_ = inv.Close()
+		err = errDCPoolsClosed
+	}
+	if err != nil {
+		e.err = err
+		// A flood wait on the login (auth.exportAuthorization) lasts as long as Telegram says;
+		// asking again sooner only gets the same answer.
+		wait := p.retryAfter
+		if d, ok := tgerr.AsFloodWait(err); ok && d > wait {
+			wait = d
+		}
+		e.retryAt = p.now().Add(wait)
+	} else {
+		e.inv = inv
+		var invoker tg.Invoker = &dcPoolInvoker{next: inv, pools: p, dc: dc, entry: e}
+		for i := len(p.middlewares) - 1; i >= 0; i-- {
+			invoker = p.middlewares[i].Handle(invoker)
+		}
+		e.api = tg.NewClient(invoker)
+	}
+	p.mu.Unlock()
+	close(e.ready)
+
+	if err != nil && !errors.Is(err, errDCPoolsClosed) {
+		p.logger.Warn("stream.dc_pool_failed", zap.Int("dc", dc), zap.Error(err))
+	} else if err == nil {
+		p.logger.Debug("stream.dc_pool_opened", zap.Int("dc", dc), zap.Int64("connections", p.size))
+	}
+}
+
+// drop closes dc's connections after its authorization stopped working; the next read opens it again.
+func (p *DCPools) drop(dc int, e *dcPool) {
+	p.mu.Lock()
+	if p.dcs[dc] != e {
+		p.mu.Unlock()
+		return
+	}
+	delete(p.dcs, dc)
+	p.mu.Unlock()
+	p.logger.Info("stream.dc_pool_dropped", zap.Int("dc", dc))
+	_ = e.inv.Close()
+}
+
+// Open is the number of DCs with open (or opening) connections.
+func (p *DCPools) Open() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	n := 0
+	for _, e := range p.dcs {
+		if e.err == nil {
+			n++
+		}
+	}
+	return n
+}
+
+// Close closes every DC's connections; later reads get the fallback.
+func (p *DCPools) Close() {
+	p.mu.Lock()
+	p.closed = true
+	dcs := p.dcs
+	p.dcs = map[int]*dcPool{}
+	p.mu.Unlock()
+	for _, e := range dcs {
+		select {
+		case <-e.ready:
+			if e.inv != nil {
+				_ = e.inv.Close()
+			}
+		default: // still opening: start sees closed and closes it
+		}
+	}
+}
+
+// dcPoolInvoker drops its DC when Telegram says the authorization there is gone.
+type dcPoolInvoker struct {
+	next  tg.Invoker
+	pools *DCPools
+	dc    int
+	entry *dcPool
+}
+
+func (i *dcPoolInvoker) Invoke(ctx context.Context, input bin.Encoder, output bin.Decoder) error {
+	err := i.next.Invoke(ctx, input, output)
+	if err != nil && auth.IsUnauthorized(err) {
+		i.pools.drop(i.dc, i.entry)
+	}
+	return err
+}
diff --git a/internal/tgc/dc_pools_test.go b/internal/tgc/dc_pools_test.go
new file mode 100644
index 0000000..5a93132
--- /dev/null
+++ b/internal/tgc/dc_pools_test.go
@@ -0,0 +1,257 @@
+package tgc
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gotd/td/bin"
+	"github.com/gotd/td/telegram"
+	"github.com/gotd/td/tg"
+	"github.com/gotd/td/tgerr"
+)
+
+// fakeInvoker answers every call with err and counts calls and Close.
+type fakeInvoker struct {
+	dc     int
+	calls  atomic.Int32
+	closed atomic.Bool
+	err    error
+}
+
+func (f *fakeInvoker) Invoke(ctx context.Context, input bin.Encoder, output bin.Decoder) error {
+	f.calls.Add(1)
+	return f.err
+}
+
+func (f *fakeInvoker) Close() error { f.closed.Store(true); return nil }
+
+type fakeOpener struct {
+	mu     sync.Mutex
+	opened []*fakeInvoker
+	opens  atomic.Int32
+	block  chan struct{} // if set, open waits for it
+	fail   func(dc int) error
+	invErr error
+}
+
+func (f *fakeOpener) open(ctx context.Context, dc int, size int64) (telegram.CloseInvoker, error) {
+	f.opens.Add(1)
+	if f.block != nil {
+		select {
+		case <-f.block:
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	if f.fail != nil {
+		if err := f.fail(dc); err != nil {
+			return nil, err
+		}
+	}
+	inv := &fakeInvoker{dc: dc, err: f.invErr}
+	f.mu.Lock()
+	f.opened = append(f.opened, inv)
+	f.mu.Unlock()
+	return inv, nil
+}
+
+func getFile(t *testing.T, c *tg.Client) error {
+	t.Helper()
+	_, err := c.UploadGetFile(context.Background(), &tg.UploadGetFileRequest{Location: &tg.InputDocumentFileLocation{ID: 1}, Limit: 1024})
+	return err
+}
+
+func TestDCPoolsOpensEachDCOnce(t *testing.T) {
+	f := &fakeOpener{block: make(chan struct{})}
+	fallback := tg.NewClient(&fakeInvoker{})
+	p := newDCPools(context.Background(), 4, f.open, fallback)
+	defer p.Close()
+
+	var wg sync.WaitGroup
+	apis := make([]*tg.Client, 30)
+	for i := range apis {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			api, err := p.API(context.Background(), 4)
+			if err != nil {
+				t.Error(err)
+			}
+			apis[i] = api
+		}(i)
+	}
+	time.Sleep(20 * time.Millisecond)
+	close(f.block)
+	wg.Wait()
+	if got := f.opens.Load(); got != 1 {
+		t.Fatalf("30 reads of DC 4 opened it %d times, want 1", got)
+	}
+	for _, api := range apis {
+		if api != apis[0] || api == fallback {
+			t.Fatal("reads of one DC got different clients, or the fallback")
+		}
+	}
+	if _, err := p.API(context.Background(), 2); err != nil {
+		t.Fatal(err)
+	}
+	if got := f.opens.Load(); got != 2 {
+		t.Fatalf("a second DC: %d opens, want 2", got)
+	}
+	if p.Open() != 2 {
+		t.Fatalf("Open() = %d, want 2", p.Open())
+	}
+}
+
+func TestDCPoolsReadsGoThroughTheDCAndMiddlewares(t *testing.T) {
+	f := &fakeOpener{}
+	var seen atomic.Int32
+	mw := telegram.MiddlewareFunc(func(next tg.Invoker) telegram.InvokeFunc {
+		return func(ctx context.Context, input bin.Encoder, output bin.Decoder) error {
+			seen.Add(1)
+			return next.Invoke(ctx, input, output)
+		}
+	})
+	fb := &fakeInvoker{}
+	p := newDCPools(context.Background(), 4, f.open, tg.NewClient(fb), mw)
+	defer p.Close()
+
+	api, _ := p.API(context.Background(), 4)
+	_ = getFile(t, api)
+	if f.opened[0].calls.Load() != 1 || fb.calls.Load() != 0 {
+		t.Fatal("the read didn't go to DC 4's connections")
+	}
+	if seen.Load() != 1 {
+		t.Fatal("the read skipped the client's middlewares")
+	}
+}
+
+func TestDCPoolsFallBackWhenADCFailsAndRetryLater(t *testing.T) {
+	failing := true
+	var mu sync.Mutex
+	f := &fakeOpener{fail: func(int) error {
+		mu.Lock()
+		defer mu.Unlock()
+		if failing {
+			return errors.New("FLOOD_WAIT")
+		}
+		return nil
+	}}
+	fallback := tg.NewClient(&fakeInvoker{})
+	p := newDCPools(context.Background(), 4, f.open, fallback)
+	defer p.Close()
+	now := time.Unix(1000, 0)
+	p.now = func() time.Time { return now }
+
+	for range 3 {
+		api, err := p.API(context.Background(), 4)
+		if err != nil || api != fallback {
+			t.Fatalf("a DC that failed to open: got %v, %v; want the fallback", api, err)
+		}
+	}
+	if got := f.opens.Load(); got != 1 {
+		t.Fatalf("reads within retry-after opened the DC %d times, want 1", got)
+	}
+
+	mu.Lock()
+	failing = false
+	mu.Unlock()
+	now = now.Add(p.retryAfter)
+	api, _ := p.API(context.Background(), 4)
+	if api == fallback || f.opens.Load() != 2 {
+		t.Fatalf("after retry-after the DC wasn't opened again (opens %d)", f.opens.Load())
+	}
+}
+
+func TestDCPoolsWaitEndsWithTheRequest(t *testing.T) {
+	f := &fakeOpener{block: make(chan struct{})}
+	p := newDCPools(context.Background(), 4, f.open, tg.NewClient(&fakeInvoker{}))
+	defer p.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if _, err := p.API(ctx, 4); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("got %v, want the request's deadline", err)
+	}
+	// The open goes on for the others: it isn't bound to the request that started it.
+	close(f.block)
+	api, err := p.API(context.Background(), 4)
+	if err != nil || api == nil || f.opens.Load() != 1 {
+		t.Fatalf("after the first request went away: %v, opens %d", err, f.opens.Load())
+	}
+}
+
+func TestDCPoolsDropADCThatLostItsAuthorization(t *testing.T) {
+	f := &fakeOpener{invErr: tgerr.New(401, "AUTH_KEY_UNREGISTERED")}
+	p := newDCPools(context.Background(), 4, f.open, tg.NewClient(&fakeInvoker{}))
+	defer p.Close()
+
+	api, _ := p.API(context.Background(), 4)
+	if err := getFile(t, api); err == nil {
+		t.Fatal("want the 401")
+	}
+	if !f.opened[0].closed.Load() {
+		t.Fatal("the DC's connections weren't closed")
+	}
+	_, _ = p.API(context.Background(), 4)
+	if got := f.opens.Load(); got != 2 {
+		t.Fatalf("the next read opened the DC %d times in all, want 2", got)
+	}
+}
+
+func TestDCPoolsCloseClosesEveryDC(t *testing.T) {
+	f := &fakeOpener{}
+	fallback := tg.NewClient(&fakeInvoker{})
+	p := newDCPools(context.Background(), 4, f.open, fallback)
+	_, _ = p.API(context.Background(), 2)
+	_, _ = p.API(context.Background(), 4)
+	p.Close()
+	for _, inv := range f.opened {
+		if !inv.closed.Load() {
+			t.Fatalf("DC %d left open", inv.dc)
+		}
+	}
+	if api, _ := p.API(context.Background(), 4); api != fallback {
+		t.Fatal("after Close a read should get the fallback")
+	}
+}
+
+func TestDCPoolsUnknownDCAndNoConnectionsUseTheFallback(t *testing.T) {
+	f := &fakeOpener{}
+	fallback := tg.NewClient(&fakeInvoker{})
+	for _, tc := range []struct{ size, dc int }{{4, 0}, {0, 4}} {
+		p := newDCPools(context.Background(), tc.size, f.open, fallback)
+		if api, _ := p.API(context.Background(), tc.dc); api != fallback {
+			t.Fatalf("size %d dc %d: want the fallback", tc.size, tc.dc)
+		}
+		p.Close()
+	}
+	if f.opens.Load() != 0 {
+		t.Fatal("nothing should have been opened")
+	}
+}
+
+func TestDCPoolsWaitOutALoginFloodWait(t *testing.T) {
+	flood := fmt.Errorf("export auth to 1: %w", tgerr.New(420, "FLOOD_WAIT_1705"))
+	f := &fakeOpener{fail: func(int) error { return flood }}
+	p := newDCPools(context.Background(), 4, f.open, tg.NewClient(&fakeInvoker{}))
+	defer p.Close()
+	now := time.Unix(1000, 0)
+	p.now = func() time.Time { return now }
+
+	_, _ = p.API(context.Background(), 1)
+	now = now.Add(10 * time.Minute)
+	_, _ = p.API(context.Background(), 1)
+	if got := f.opens.Load(); got != 1 {
+		t.Fatalf("asked again %d times within the 1705s flood wait", got-1)
+	}
+	now = now.Add(1705*time.Second - 10*time.Minute)
+	_, _ = p.API(context.Background(), 1)
+	if got := f.opens.Load(); got != 2 {
+		t.Fatalf("after the flood wait: %d opens, want 2", got)
+	}
+}
diff --git a/internal/tgc/helpers.go b/internal/tgc/helpers.go
