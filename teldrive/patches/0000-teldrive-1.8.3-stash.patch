diff --git a/internal/tgc/stream_pool.go b/internal/tgc/stream_pool.go
new file mode 100644
index 0000000..2b7f69e
--- /dev/null
+++ b/internal/tgc/stream_pool.go
@@ -0,0 +1,205 @@
+package tgc
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/gotd/td/telegram"
+	"github.com/gotd/td/tg"
+)
+
+// ErrStreamPoolClosed is returned by Acquire after Close.
+var ErrStreamPoolClosed = errors.New("stream client pool is closed")
+
+// StreamClientRunner runs one bot's client until ctx ends: it connects, logs the bot in, calls
+// ready once the client can be used, then keeps it running. It returns when the client stops.
+type StreamClientRunner func(ctx context.Context, token string, ready func(*WarmClient)) error
+
+// WarmClient is a bot's running client and its connections to the DCs that hold files.
+type WarmClient struct {
+	*telegram.Client
+	DCs *DCPools // nil: every read goes through the client's API
+}
+
+// DCAPI returns the client to read a file stored on dc with.
+func (c *WarmClient) DCAPI(ctx context.Context, dc int) (*tg.Client, error) {
+	if c.DCs == nil {
+		return c.API(), nil
+	}
+	return c.DCs.API(ctx, dc)
+}
+
+// StreamPool keeps one running client per streaming bot, shared by every stream request,
+// instead of a new client per request. A new client has to log in to the DC that holds the file
+// (auth.exportAuthorization / importAuthorization) before it can read; Telegram rate-limits
+// those, so a Plex scan opening hundreds of files ran the bots into FLOOD_WAIT and
+// AUTH_BYTES_INVALID. A pooled client logs in to each DC once and keeps the connection.
+// Clients unused for the idle time are closed; one that stops (an error, a lost login) is
+// dropped and the next request starts a fresh one.
+type StreamPool struct {
+	run  StreamClientRunner
+	idle time.Duration
+	now  func() time.Time
+
+	ctx    context.Context
+	cancel context.CancelFunc
+
+	mu      sync.Mutex
+	clients map[string]*pooledClient
+	closed  bool
+}
+
+type pooledClient struct {
+	token    string
+	cancel   context.CancelFunc
+	ready    chan struct{} // closed once client or err is set
+	done     chan struct{} // closed when the client has stopped
+	client   *WarmClient
+	err      error
+	refs     int
+	lastUsed time.Time
+}
+
+// NewStreamPool starts the idle reaper; Close stops it and every client.
+func NewStreamPool(run StreamClientRunner, idle time.Duration) *StreamPool {
+	ctx, cancel := context.WithCancel(context.Background())
+	p := &StreamPool{run: run, idle: idle, now: time.Now, ctx: ctx, cancel: cancel, clients: map[string]*pooledClient{}}
+	if idle > 0 {
+		go p.reaper(min(idle, time.Minute))
+	}
+	return p
+}
+
+// Acquire returns the running client of the bot with this token, starting it if needed, and a
+// release func to call when the request is done with it. It waits for the client to be ready
+// (or ctx to end). The client is shared: use it, don't Run or stop it.
+func (p *StreamPool) Acquire(ctx context.Context, token string) (*WarmClient, func(), error) {
+	pc, err := p.lease(token)
+	if err != nil {
+		return nil, nil, err
+	}
+	release := sync.OnceFunc(func() { p.release(pc) })
+	select {
+	case <-pc.ready:
+	case <-ctx.Done():
+		release()
+		return nil, nil, ctx.Err()
+	}
+	p.mu.Lock()
+	client, runErr := pc.client, pc.err
+	p.mu.Unlock()
+	if runErr != nil || client == nil {
+		release()
+		if runErr == nil {
+			runErr = errors.New("stream client stopped")
+		}
+		return nil, nil, runErr
+	}
+	return client, release, nil
+}
+
+func (p *StreamPool) lease(token string) (*pooledClient, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed {
+		return nil, ErrStreamPoolClosed
+	}
+	if pc := p.clients[token]; pc != nil && pc.err == nil {
+		pc.refs++
+		pc.lastUsed = p.now()
+		return pc, nil
+	}
+	runCtx, cancel := context.WithCancel(p.ctx)
+	pc := &pooledClient{token: token, cancel: cancel, ready: make(chan struct{}), done: make(chan struct{}),
+		refs: 1, lastUsed: p.now()}
+	p.clients[token] = pc
+	go p.start(runCtx, pc)
+	return pc, nil
+}
+
+func (p *StreamPool) start(ctx context.Context, pc *pooledClient) {
+	readyOnce := sync.Once{}
+	err := p.run(ctx, pc.token, func(c *WarmClient) {
+		p.mu.Lock()
+		pc.client = c
+		p.mu.Unlock()
+		readyOnce.Do(func() { close(pc.ready) })
+	})
+	if err == nil {
+		err = errors.New("stream client stopped")
+	}
+	p.mu.Lock()
+	pc.client = nil
+	pc.err = err
+	if p.clients[pc.token] == pc {
+		delete(p.clients, pc.token)
+	}
+	p.mu.Unlock()
+	readyOnce.Do(func() { close(pc.ready) })
+	close(pc.done)
+}
+
+func (p *StreamPool) release(pc *pooledClient) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if pc.refs > 0 {
+		pc.refs--
+	}
+	pc.lastUsed = p.now()
+}
+
+func (p *StreamPool) reaper(every time.Duration) {
+	t := time.NewTicker(every)
+	defer t.Stop()
+	for {
+		select {
+		case <-p.ctx.Done():
+			return
+		case <-t.C:
+			p.reapIdle()
+		}
+	}
+}
+
+// reapIdle stops the clients nobody used for the idle time.
+func (p *StreamPool) reapIdle() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	now := p.now()
+	for token, pc := range p.clients {
+		if pc.refs == 0 && now.Sub(pc.lastUsed) >= p.idle {
+			delete(p.clients, token)
+			pc.cancel()
+		}
+	}
+}
+
+// Running is the number of bots with a running (or starting) client.
+func (p *StreamPool) Running() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return len(p.clients)
+}
+
+// Close stops every client and waits for them (or ctx).
+func (p *StreamPool) Close(ctx context.Context) error {
+	p.mu.Lock()
+	p.closed = true
+	clients := make([]*pooledClient, 0, len(p.clients))
+	for _, pc := range p.clients {
+		clients = append(clients, pc)
+	}
+	p.clients = map[string]*pooledClient{}
+	p.mu.Unlock()
+	p.cancel()
+	for _, pc := range clients {
+		select {
+		case <-pc.done:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return nil
+}
diff --git a/internal/tgc/stream_pool_test.go b/internal/tgc/stream_pool_test.go
new file mode 100644
index 0000000..6c52437
--- /dev/null
+++ b/internal/tgc/stream_pool_test.go
@@ -0,0 +1,163 @@
+package tgc
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gotd/td/telegram"
+)
+
+// fakeRunner counts client starts; each client is ready at once and runs until its ctx ends
+// (or fail returns an error for that start).
+type fakeRunner struct {
+	starts atomic.Int32
+	fail   func(n int32) error
+}
+
+func (f *fakeRunner) run(ctx context.Context, token string, ready func(*WarmClient)) error {
+	n := f.starts.Add(1)
+	if f.fail != nil {
+		if err := f.fail(n); err != nil {
+			return err
+		}
+	}
+	ready(&WarmClient{Client: &telegram.Client{}})
+	<-ctx.Done()
+	return ctx.Err()
+}
+
+func TestStreamPoolReusesTheBotsClient(t *testing.T) {
+	f := &fakeRunner{}
+	p := NewStreamPool(f.run, time.Hour)
+	defer p.Close(context.Background())
+
+	var wg sync.WaitGroup
+	clients := make([]*WarmClient, 20)
+	for i := range clients {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			c, release, err := p.Acquire(context.Background(), "111:bot")
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			clients[i] = c
+			release()
+		}(i)
+	}
+	wg.Wait()
+	if got := f.starts.Load(); got != 1 {
+		t.Fatalf("20 requests for one bot started %d clients, want 1", got)
+	}
+	for _, c := range clients[1:] {
+		if c != clients[0] {
+			t.Fatal("requests got different clients for the same bot")
+		}
+	}
+	if _, release, err := p.Acquire(context.Background(), "222:bot"); err != nil {
+		t.Fatal(err)
+	} else {
+		release()
+	}
+	if f.starts.Load() != 2 || p.Running() != 2 {
+		t.Fatalf("a second bot: starts %d running %d, want 2 and 2", f.starts.Load(), p.Running())
+	}
+}
+
+func TestStreamPoolClosesIdleClients(t *testing.T) {
+	f := &fakeRunner{}
+	p := NewStreamPool(f.run, 30*time.Minute)
+	defer p.Close(context.Background())
+	now := time.Now()
+	p.now = func() time.Time { return now }
+
+	_, release, err := p.Acquire(context.Background(), "111:bot")
+	if err != nil {
+		t.Fatal(err)
+	}
+	now = now.Add(time.Hour)
+	p.reapIdle()
+	if p.Running() != 1 {
+		t.Fatal("a client in use was closed")
+	}
+	release()
+	now = now.Add(10 * time.Minute)
+	p.reapIdle()
+	if p.Running() != 1 {
+		t.Fatal("closed before the idle time")
+	}
+	now = now.Add(30 * time.Minute)
+	p.reapIdle()
+	if p.Running() != 0 {
+		t.Fatal("an idle client wasn't closed")
+	}
+	if _, release, err := p.Acquire(context.Background(), "111:bot"); err != nil {
+		t.Fatal(err)
+	} else {
+		release()
+	}
+	if f.starts.Load() != 2 {
+		t.Fatalf("after the idle close the next request should start a new client: starts %d", f.starts.Load())
+	}
+}
+
+func TestStreamPoolRestartsAStoppedClient(t *testing.T) {
+	boom := errors.New("AUTH_KEY_UNREGISTERED")
+	f := &fakeRunner{fail: func(n int32) error {
+		if n == 1 {
+			return boom
+		}
+		return nil
+	}}
+	p := NewStreamPool(f.run, time.Hour)
+	defer p.Close(context.Background())
+
+	if _, _, err := p.Acquire(context.Background(), "111:bot"); !errors.Is(err, boom) {
+		t.Fatalf("first start fails: got %v, want %v", err, boom)
+	}
+	if _, release, err := p.Acquire(context.Background(), "111:bot"); err != nil {
+		t.Fatalf("the next request should start a fresh client: %v", err)
+	} else {
+		release()
+	}
+	if f.starts.Load() != 2 {
+		t.Fatalf("starts %d, want 2", f.starts.Load())
+	}
+}
+
+func TestStreamPoolAcquireStopsWithTheRequest(t *testing.T) {
+	slow := func(ctx context.Context, token string, ready func(*WarmClient)) error {
+		<-ctx.Done() // never ready
+		return ctx.Err()
+	}
+	p := NewStreamPool(slow, time.Hour)
+	defer p.Close(context.Background())
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if _, _, err := p.Acquire(ctx, "111:bot"); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("got %v, want the request's deadline", err)
+	}
+}
+
+func TestStreamPoolClose(t *testing.T) {
+	f := &fakeRunner{}
+	p := NewStreamPool(f.run, time.Hour)
+	if _, release, err := p.Acquire(context.Background(), "111:bot"); err != nil {
+		t.Fatal(err)
+	} else {
+		release()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := p.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := p.Acquire(context.Background(), "111:bot"); !errors.Is(err, ErrStreamPoolClosed) {
+		t.Fatalf("after Close: got %v", err)
+	}
+}
