diff --git a/fs/chunkedreader/parallel_short_test.go b/fs/chunkedreader/parallel_short_test.go
new file mode 100644
index 000000000..272e305eb
--- /dev/null
+++ b/fs/chunkedreader/parallel_short_test.go
@@ -0,0 +1,135 @@
+package chunkedreader
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fstest/mockobject"
+	"github.com/rclone/rclone/lib/multipart"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// shortObject is a mock object whose downloads end early: each opened range returns only its
+// first `keep` bytes, then EOF or err (a server that closed the response half way).
+type shortObject struct {
+	*mockobject.ContentMockObject
+	keep     int64
+	err      error
+	maxOpens int32 // > 0: opens after this many fail (the server is gone, so reopening can't help)
+	opens    atomic.Int32
+}
+
+type shortReader struct {
+	io.ReadCloser
+	left int64
+	err  error
+}
+
+func (r *shortReader) Read(p []byte) (int, error) {
+	if r.left <= 0 {
+		return 0, r.err
+	}
+	if int64(len(p)) > r.left {
+		p = p[:r.left]
+	}
+	n, err := r.ReadCloser.Read(p)
+	r.left -= int64(n)
+	return n, err
+}
+
+func (o *shortObject) Open(ctx context.Context, options ...fs.OpenOption) (io.ReadCloser, error) {
+	if n := o.opens.Add(1); o.maxOpens > 0 && n > o.maxOpens {
+		return nil, errors.New("server gone")
+	}
+	rc, err := o.ContentMockObject.Open(ctx, options...)
+	if err != nil {
+		return nil, err
+	}
+	return &shortReader{ReadCloser: rc, left: o.keep, err: o.err}, nil
+}
+
+// A stream whose download ends before its range is complete must fail the read, not wait
+// for data that will never come (Plex's scanner hung in D state for 30 minutes on a mount).
+func TestParallelShortStreamFails(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		err      error
+		maxOpens int32
+		complete bool // rclone's reopen gets the rest
+	}{
+		{name: "response ends early without an error", err: io.EOF},
+		{name: "unexpected EOF, reopen fails", err: io.ErrUnexpectedEOF, maxOpens: 2},
+		{name: "unexpected EOF, reopen works", err: io.ErrUnexpectedEOF, complete: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			const chunkSize = multipart.BufferSize
+			content := makeContent(t, 4*chunkSize)
+			o := &shortObject{
+				ContentMockObject: mockobject.New("short.bin").WithContent(content, mockobject.SeekModeNone),
+				keep:              chunkSize / 2,
+				err:               tc.err,
+				maxOpens:          tc.maxOpens,
+			}
+			cr := New(ctx, o, chunkSize, 0, 2)
+			done := make(chan error, 1)
+			var got []byte
+			go func() {
+				var err error
+				got, err = io.ReadAll(cr)
+				done <- err
+			}()
+			select {
+			case err := <-done:
+				if tc.complete {
+					require.NoError(t, err)
+					assert.Equal(t, content, got)
+				} else {
+					require.Error(t, err)
+					assert.Equal(t, content[:len(got)], got, "what was read is the file's data")
+					assert.Less(t, len(got), len(content))
+				}
+			case <-time.After(10 * time.Second):
+				t.Fatal("read still waiting 10 s after the download ended early")
+			}
+			_ = cr.Close()
+		})
+	}
+}
+
+// Seeking into the part of a stream its (short) download never reached restarts there.
+func TestParallelSeekPastShortStream(t *testing.T) {
+	ctx := context.Background()
+	const chunkSize = multipart.BufferSize
+	content := makeContent(t, 4*chunkSize)
+	o := &shortObject{
+		ContentMockObject: mockobject.New("short.bin").WithContent(content, mockobject.SeekModeNone),
+		keep:              chunkSize / 2,
+		err:               io.ErrUnexpectedEOF,
+	}
+	cr := New(ctx, o, chunkSize, 0, 2)
+	buf := make([]byte, 16)
+	_, err := io.ReadFull(cr, buf) // starts the streams
+	require.NoError(t, err)
+	done := make(chan error, 1)
+	go func() {
+		_, err := cr.Seek(chunkSize-100, io.SeekStart) // past the 1/2 chunk the stream got
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		require.NoError(t, err)
+	case <-time.After(10 * time.Second):
+		t.Fatal("seek still waiting 10 s after the download ended early")
+	}
+	n, err := io.ReadFull(cr, buf)
+	require.NoError(t, err)
+	assert.Equal(t, content[chunkSize-100:chunkSize-100+n], buf[:n])
+	require.NoError(t, cr.Close())
+}
